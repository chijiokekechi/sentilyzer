# Sentilyzer environment configuration
# Copy to `.env` and fill in. All keys are optional; without them the
# corresponding connector falls back to disabled (or to the Mock connector
# when SENTILYZER_USE_MOCK=true).

# === API server ===
SENTILYZER_HTTP_ADDR=:8080
SENTILYZER_GRPC_ADDR=:9090
SENTILYZER_LOG_LEVEL=info
SENTILYZER_USE_MOCK=false

# === ML inference service ===
SENTILYZER_ML_ADDR=localhost:50051
SENTILYZER_ML_GENERAL_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTILYZER_ML_ASPECT_MODEL=yangheng/deberta-v3-base-absa-v1.1
SENTILYZER_ML_DEVICE=cpu
# Read by BOTH processes and they must agree: the worker rejects any batch
# above this, and the API splits requests into batches of at most this size.
# Setting it on only one side breaks every request larger than the lower value.
SENTILYZER_ML_MAX_BATCH=32

# === Cache ===
SENTILYZER_CACHE_TTL=10m

# === Rate limiting (requests/minute; 0 disables that limiter) ===
# Per-instance is sufficient: the single-box / failover deployments never serve
# from two instances at once, so a per-instance limit is effectively global.
SENTILYZER_RATE_IP_RPM=120
SENTILYZER_RATE_GLOBAL_RPM=1200

# === Reddit (script-app credentials, https://www.reddit.com/prefs/apps) ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sentilyzer/0.1 by yourname

# === StockTwits (no auth required for public streams) ===

# === HackerNews (no auth required) ===

# === Twitter / X (v2 bearer token; optional) ===
TWITTER_BEARER_TOKEN=

# === Mastodon (instance + access token; optional) ===
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# === YouTube Data API v3 (optional) ===
YOUTUBE_API_KEY=
